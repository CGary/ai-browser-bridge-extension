# Proton VPN OpenVPN credentials for gluetun.
# Get these at: https://account.proton.me/  (account -> OpenVPN/IKEv2 username)
#
# Copy this file to vpn.env in the same directory and fill in real values:
#   cp configs/docker/vpn.env.example configs/docker/vpn.env
#
# vpn.env is git-ignored by configs/docker/*.env — never commit it.

OPENVPN_USER=your_proton_openvpn_user_here
OPENVPN_PASSWORD=your_proton_openvpn_password_here
